# Cloudflare R2 & Worker Configuration Example
# Copy to .env or .dev.vars when uploading or testing locally

# Cloudflare Account ID (Found on Cloudflare dashboard home page right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare R2 API Tokens (Manage R2 API Tokens in R2 Overview)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# Media CDN Endpoint (Public custom domain or worker route)
VITE_MEDIA_BASE_URL=https://media.yourdomain.com
