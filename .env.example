# Edge & Media Service Environment Configuration Example
# Copy to .env or .dev.vars when testing locally

# Gemini API Key
GEMINI_API_KEY=[REDACTED_SECRET]

# Media Service Endpoint & Token Minting
VITE_MEDIA_BASE_URL=https://media.example.com
MEDIA_SERVICE_API_KEY=[REDACTED_SECRET]

# Site Domain & Contact
VITE_DOMAIN_URL=https://example.com
VITE_CONTACT_EMAIL=user@example.com
