# Edge & Object Storage Environment Configuration Example
# Copy to .env or .dev.vars when testing locally

# API Key
GEMINI_API_KEY=[REDACTED_SECRET]

# Cloud Provider Account & Storage Identifiers
CLOUD_ACCOUNT_ID=[REDACTED_CLOUD_RESOURCE]
STORAGE_ACCESS_KEY_ID=[REDACTED_SECRET]
STORAGE_SECRET_ACCESS_KEY=[REDACTED_SECRET]
STORAGE_BUCKET_NAME=[REDACTED_CLOUD_RESOURCE]

# Media CDN Endpoint & Site Domain
VITE_MEDIA_BASE_URL=https://media.example.com
VITE_DOMAIN_URL=https://example.com
VITE_CONTACT_EMAIL=user@example.com

