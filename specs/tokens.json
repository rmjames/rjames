{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Robert James Portfolio Design Tokens",
  "description": "W3C Design Tokens Community Group (DTCG) specification format for robertjames.nyc design system.",
  "color": {
    "$type": "color",
    "white-1": {
      "$value": "oklch(1 0 0)",
      "$description": "Pure white, dark-mode text and light-mode background",
      "$extensions": {
        "fallback": "hsl(0, 0%, 100%)"
      }
    },
    "white-2": {
      "$value": "oklch(0.98 0 0)",
      "$description": "Off-white subtle background and surface highlight",
      "$extensions": {
        "fallback": "hsl(0, 0%, 98%)"
      }
    },
    "black-1": {
      "$value": "oklch(0 0 0)",
      "$description": "Deep absolute black",
      "$extensions": {
        "fallback": "hsl(360 0% 0%)"
      }
    },
    "black-2": {
      "$value": "oklch(from hsl(46 94% 119%) l c h)",
      "$description": "High-chroma warm black accent",
      "$extensions": {
        "fallback": "hsl(46 94% 119%)"
      }
    },
    "black-3": {
      "$value": "oklch(from hsl(200 16% 16%) l c h)",
      "$description": "Charcoal dark base background and primary text",
      "$extensions": {
        "fallback": "hsl(200 16% 16%)"
      }
    },
    "black-4": {
      "$value": "oklch(from hsl(0 0% 20%) l c h)",
      "$description": "Mid-dark charcoal for borders and icons",
      "$extensions": {
        "fallback": "hsl(0 0% 20%)"
      }
    },
    "black-5": {
      "$value": "oklch(from hsl(0 0% 47%) l c h)",
      "$description": "Dimmed subtle gray-black",
      "$extensions": {
        "fallback": "hsl(0 0% 47%)"
      }
    },
    "gray-1": {
      "$value": "oklch(from hsl(200 8% 45%) l c h)",
      "$description": "Cool slate brand token and selection highlight",
      "$extensions": {
        "fallback": "hsl(200, 8%, 45%)"
      }
    },
    "gray-2": {
      "$value": "oklch(from #6d7f88 l c h)",
      "$description": "Muted slate secondary text and brand button neutral",
      "$extensions": {
        "fallback": "#6d7f88"
      }
    },
    "blue-1": {
      "$value": "oklch(from hsl(200 100% 32.9%) l c h)",
      "$description": "Deep royal blue for LinkedIn active and hover states",
      "$extensions": {
        "fallback": "hsl(200 100% 32.9%)"
      }
    },
    "blue-2": {
      "$value": "oklch(from hsl(201 44% 43%) l c h)",
      "$description": "Accent link blue and border highlights",
      "$extensions": {
        "fallback": "hsl(201 44% 43%)"
      }
    },
    "blue-3": {
      "$value": "oklch(from hsl(204 100% 51%) l c h)",
      "$description": "Vivid sky blue for subtle dark-mode color mixing",
      "$extensions": {
        "fallback": "hsl(204 100% 51%)"
      }
    },
    "blue-4": {
      "$value": "oklch(from hsl(203 89.2% 52.9%) l c h)",
      "$description": "Electric cyan-blue for Twitter/X hover states",
      "$extensions": {
        "fallback": "hsl(203 89.2% 52.9%)"
      }
    },
    "orange-1": {
      "$value": "oklch(from hsla(30 60.7% 58% / .66) l c h)",
      "$description": "Warm transparent amber glow",
      "$extensions": {
        "fallback": "hsla(30 60.7% 58% / .66)"
      }
    },
    "orange-2": {
      "$value": "oklch(from hsl(38.8 100% 50%) l c h)",
      "$description": "Vivid amber for interactive button focus rings",
      "$extensions": {
        "fallback": "hsl(38.8 100% 50%)"
      }
    },
    "orange-3": {
      "$value": "oklch(from hsl(13.9 95.2% 67.1%) l c h)",
      "$description": "Coral orange highlight",
      "$extensions": {
        "fallback": "hsl(13.9 95.2% 67.1%)"
      }
    },
    "orange-4": {
      "$value": "oklch(from #777 l c h)",
      "$description": "Warm shadow and email accent",
      "$extensions": {
        "fallback": "#777"
      }
    },
    "semantic": {
      "bkgnd": {
        "$value": "{color.black-3}",
        "$description": "Default dark background token"
      },
      "color-brand": {
        "$value": "{color.gray-1}",
        "$description": "Primary brand color"
      },
      "text-dark": {
        "$value": "{color.black-3}",
        "$description": "Text color in light mode"
      },
      "text-light": {
        "$value": "{color.white-1}",
        "$description": "Text color in dark mode"
      },
      "link-color": {
        "$value": "{color.blue-2}",
        "$description": "Interactive text link color"
      },
      "selection-color": {
        "$value": "{color.gray-1}",
        "$description": "Text selection background color"
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "spacing": {
      "xxs": {
        "$value": "0.125rem",
        "$description": "Hairline borders, micro-offsets (2px)"
      },
      "xs": {
        "$value": "0.25rem",
        "$description": "Tight element padding, badges (4px)"
      },
      "s": {
        "$value": "0.5rem",
        "$description": "Border radius, compact gaps (8px)"
      },
      "m": {
        "$value": "1rem",
        "$description": "Standard component padding, container margins (16px)"
      },
      "l": {
        "$value": "1.25rem",
        "$description": "Intermediate spatial breaks (20px)"
      },
      "xl": {
        "$value": "1.5rem",
        "$description": "Section separation, icon containers (24px)"
      },
      "xxl": {
        "$value": "2rem",
        "$description": "Major structural gaps and popover exit offsets (32px)"
      },
      "xxxl": {
        "$value": "3rem",
        "$description": "Hero typography sizing and macro spacing (48px)"
      }
    },
    "borderRadius": {
      "border-radius": {
        "$value": "{dimension.spacing.s}",
        "$description": "Default component border radius"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "font-stack": {
        "$value": [
          "Recursive",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Primary variable font stack"
      }
    },
    "variableAxes": {
      "$type": "number",
      "recursive-wght": {
        "$value": 400,
        "$description": "Recursive variable weight axis (wght: 100-1000)"
      },
      "recursive-CASL": {
        "$value": 0,
        "$description": "Recursive casual axis (CASL: 0.0-1.0)"
      },
      "recursive-MONO": {
        "$value": 0,
        "$description": "Recursive monospace axis (MONO: 0.0-1.0)"
      },
      "recursive-CRSV": {
        "$value": 0.5,
        "$description": "Recursive cursive axis (CRSV: 0.0-1.0)"
      },
      "recursive-slnt": {
        "$value": 0,
        "$description": "Recursive slant axis (slnt: -15 to 0)"
      }
    },
    "fontSize": {
      "$type": "dimension",
      "f-base": {
        "$value": "14px",
        "$description": "Base font size reference value"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "link": {
        "$value": "444ms",
        "$description": "Standard link and popover interaction timing"
      }
    },
    "cubicBezier": {
      "$type": "cubicBezier",
      "link": {
        "$value": [0.2, 0.8, 0.2, 1],
        "$description": "Primary interactive easing curve"
      },
      "ease-3": {
        "$value": [0.25, 0, 0.3, 1],
        "$description": "Secondary smooth acceleration curve"
      }
    }
  }
}
