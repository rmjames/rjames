{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Robert James Portfolio Design Tokens",
  "description": "W3C Design Tokens Community Group (DTCG) specification format for robertjames.nyc design system, including email confirmation and checkout components.",
  "color": {
    "$type": "color",
    "white-1": {
      "$value": "oklch(1 0 0)",
      "$description": "Pure white, dark-mode text and light-mode background",
      "$extensions": {
        "fallback": "hsl(0, 0%, 100%)"
      }
    },
    "white-2": {
      "$value": "oklch(0.98 0 0)",
      "$description": "Off-white subtle background and surface highlight",
      "$extensions": {
        "fallback": "hsl(0, 0%, 98%)"
      }
    },
    "black-1": {
      "$value": "oklch(0 0 0)",
      "$description": "Deep absolute black",
      "$extensions": {
        "fallback": "hsl(360 0% 0%)"
      }
    },
    "black-2": {
      "$value": "oklch(from hsl(46 94% 119%) l c h)",
      "$description": "High-chroma warm black accent",
      "$extensions": {
        "fallback": "hsl(46 94% 119%)"
      }
    },
    "black-3": {
      "$value": "oklch(from hsl(200 16% 16%) l c h)",
      "$description": "Charcoal dark base background and primary text",
      "$extensions": {
        "fallback": "hsl(200 16% 16%)"
      }
    },
    "black-4": {
      "$value": "oklch(from hsl(0 0% 20%) l c h)",
      "$description": "Mid-dark charcoal for borders and icons",
      "$extensions": {
        "fallback": "hsl(0 0% 20%)"
      }
    },
    "black-5": {
      "$value": "oklch(from hsl(0 0% 47%) l c h)",
      "$description": "Dimmed subtle gray-black",
      "$extensions": {
        "fallback": "hsl(0 0% 47%)"
      }
    },
    "gray-1": {
      "$value": "oklch(from hsl(200 8% 45%) l c h)",
      "$description": "Cool slate brand token and selection highlight",
      "$extensions": {
        "fallback": "hsl(200, 8%, 45%)"
      }
    },
    "gray-2": {
      "$value": "oklch(from #6d7f88 l c h)",
      "$description": "Muted slate secondary text and brand button neutral",
      "$extensions": {
        "fallback": "#6d7f88"
      }
    },
    "blue-1": {
      "$value": "oklch(from hsl(200 100% 32.9%) l c h)",
      "$description": "Deep royal blue for LinkedIn active and hover states",
      "$extensions": {
        "fallback": "hsl(200 100% 32.9%)"
      }
    },
    "blue-2": {
      "$value": "oklch(from hsl(201 44% 43%) l c h)",
      "$description": "Accent link blue and border highlights",
      "$extensions": {
        "fallback": "hsl(201 44% 43%)"
      }
    },
    "blue-3": {
      "$value": "oklch(from hsl(204 100% 51%) l c h)",
      "$description": "Vivid sky blue for subtle dark-mode color mixing",
      "$extensions": {
        "fallback": "hsl(204 100% 51%)"
      }
    },
    "blue-4": {
      "$value": "oklch(from hsl(203 89.2% 52.9%) l c h)",
      "$description": "Electric cyan-blue for Twitter/X hover states",
      "$extensions": {
        "fallback": "hsl(203 89.2% 52.9%)"
      }
    },
    "orange-1": {
      "$value": "oklch(from hsla(30 60.7% 58% / .66) l c h)",
      "$description": "Warm transparent amber glow",
      "$extensions": {
        "fallback": "hsla(30 60.7% 58% / .66)"
      }
    },
    "orange-2": {
      "$value": "oklch(from hsl(38.8 100% 50%) l c h)",
      "$description": "Vivid amber for interactive button focus rings",
      "$extensions": {
        "fallback": "hsl(38.8 100% 50%)"
      }
    },
    "orange-3": {
      "$value": "oklch(from hsl(13.9 95.2% 67.1%) l c h)",
      "$description": "Coral orange highlight",
      "$extensions": {
        "fallback": "hsl(13.9 95.2% 67.1%)"
      }
    },
    "orange-4": {
      "$value": "oklch(from #777 l c h)",
      "$description": "Warm shadow and email accent",
      "$extensions": {
        "fallback": "#777"
      }
    },
    "google-blue": {
      "$value": "oklch(from #1a73e8 l c h)",
      "$description": "Google accent blue for checkout checkpoints, links, and buttons",
      "$extensions": {
        "fallback": "#1a73e8"
      }
    },
    "google-blue-hover": {
      "$value": "oklch(from #1557b0 l c h)",
      "$description": "Hover state for primary checkout and email CTA buttons",
      "$extensions": {
        "fallback": "#1557b0"
      }
    },
    "google-green": {
      "$value": "oklch(from #34a853 l c h)",
      "$description": "Google quad-color brand green",
      "$extensions": {
        "fallback": "#34a853"
      }
    },
    "google-yellow": {
      "$value": "oklch(from #fbbc04 l c h)",
      "$description": "Google quad-color brand yellow",
      "$extensions": {
        "fallback": "#fbbc04"
      }
    },
    "google-red": {
      "$value": "oklch(from #ea4335 l c h)",
      "$description": "Google quad-color brand red",
      "$extensions": {
        "fallback": "#ea4335"
      }
    },
    "google-logo-blue": {
      "$value": "oklch(from #4285f4 l c h)",
      "$description": "Google logo blue mark component",
      "$extensions": {
        "fallback": "#4285f4"
      }
    },
    "google-yellow-highlight": {
      "$value": "oklch(from #ffd966 l c h)",
      "$description": "Light mode highlight background for brand text",
      "$extensions": {
        "fallback": "#ffd966"
      }
    },
    "google-yellow-soft": {
      "$value": "oklch(from #fce8e6 l c h)",
      "$description": "Soft tint peach/yellow highlight",
      "$extensions": {
        "fallback": "#fce8e6"
      }
    },
    "gray-neutral-light": {
      "$value": "oklch(from #dadce0 l c h)",
      "$description": "Light mode border neutral for checkout cards and inactive checkpoints",
      "$extensions": {
        "fallback": "#dadce0"
      }
    },
    "gray-neutral-dark": {
      "$value": "oklch(from #5f6368 l c h)",
      "$description": "Dark mode border and secondary neutral",
      "$extensions": {
        "fallback": "#5f6368"
      }
    },
    "gray-text-dark": {
      "$value": "oklch(from #9aa0a6 l c h)",
      "$description": "Dark mode secondary muted text",
      "$extensions": {
        "fallback": "#9aa0a6"
      }
    },
    "surface-dark-1": {
      "$value": "oklch(from #202124 l c h)",
      "$description": "Google dark mode base canvas and primary dark text in light mode",
      "$extensions": {
        "fallback": "#202124"
      }
    },
    "surface-dark-2": {
      "$value": "oklch(from #303134 l c h)",
      "$description": "Google dark mode elevated card container",
      "$extensions": {
        "fallback": "#303134"
      }
    },
    "surface-dark-3": {
      "$value": "oklch(from #292a2d l c h)",
      "$description": "Google dark mode email card sheet",
      "$extensions": {
        "fallback": "#292a2d"
      }
    },
    "surface-light-1": {
      "$value": "oklch(from #f8f9fa l c h)",
      "$description": "Light mode off-white background canvas",
      "$extensions": {
        "fallback": "#f8f9fa"
      }
    },
    "surface-light-ec": {
      "$value": "oklch(from #f6f8fc l c h)",
      "$description": "Gmail web client light background canvas",
      "$extensions": {
        "fallback": "#f6f8fc"
      }
    },
    "surface-dark-ec": {
      "$value": "oklch(from #18191a l c h)",
      "$description": "Gmail web client dark background canvas",
      "$extensions": {
        "fallback": "#18191a"
      }
    },
    "semantic": {
      "bkgnd": {
        "$value": "{color.black-3}",
        "$description": "Default dark background token"
      },
      "color-brand": {
        "$value": "{color.gray-1}",
        "$description": "Primary brand color"
      },
      "text-dark": {
        "$value": "{color.black-3}",
        "$description": "Text color in light mode"
      },
      "text-light": {
        "$value": "{color.white-1}",
        "$description": "Text color in dark mode"
      },
      "link-color": {
        "$value": "{color.blue-2}",
        "$description": "Interactive text link color"
      },
      "selection-color": {
        "$value": "{color.gray-1}",
        "$description": "Text selection background color"
      },
      "checkout-accent-blue": {
        "$value": "oklch(from #1a73e8 l c h)",
        "$description": "Active checkout checkmark and CTA button color"
      },
      "checkout-border-color": {
        "$value": "light-dark(oklch(from #dadce0 l c h), oklch(from #5f6368 l c h / .5))",
        "$description": "Checkout card and milestone border color"
      },
      "checkout-card-bg": {
        "$value": "light-dark(oklch(from #ffffff l c h), oklch(from #303134 l c h))",
        "$description": "Checkout card background surface"
      },
      "checkout-text-primary": {
        "$value": "light-dark(oklch(from #202124 l c h), oklch(from #e8eaed l c h))",
        "$description": "Checkout primary text and headlines"
      },
      "checkout-text-secondary": {
        "$value": "light-dark(oklch(from #5f6368 l c h), oklch(from #9aa0a6 l c h))",
        "$description": "Checkout secondary order dates and metadata"
      },
      "checkout-highlight-bg": {
        "$value": "light-dark(oklch(from #ffd966 l c h), oklch(from #fbbc04 l c h))",
        "$description": "Brand text highlight background badge"
      },
      "ec-app-bg": {
        "$value": "light-dark(oklch(from #f6f8fc l c h), oklch(from #18191a l c h))",
        "$description": "Gmail web client app background"
      },
      "ec-surface": {
        "$value": "light-dark(oklch(from #ffffff l c h), oklch(from #242526 l c h))",
        "$description": "Gmail web client message pane surface"
      },
      "ec-border": {
        "$value": "light-dark(oklch(from #e0e0e0 l c h), oklch(from #3a3b3c l c h))",
        "$description": "Gmail web client chrome divider border"
      },
      "ec-active-bg": {
        "$value": "light-dark(oklch(91% .08 260), oklch(35% .18 260 / .2))",
        "$description": "Gmail web client active sidebar background"
      },
      "ec-active-color": {
        "$value": "light-dark(oklch(35% .18 260), oklch(85% .15 260))",
        "$description": "Gmail web client active accent text"
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "spacing": {
      "xxs": {
        "$value": "0.125rem",
        "$description": "Hairline borders, micro-offsets (2px)"
      },
      "xs": {
        "$value": "0.25rem",
        "$description": "Tight element padding, badges (4px)"
      },
      "s": {
        "$value": "0.5rem",
        "$description": "Border radius, compact gaps (8px)"
      },
      "m": {
        "$value": "1rem",
        "$description": "Standard component padding, container margins (16px)"
      },
      "l": {
        "$value": "1.25rem",
        "$description": "Intermediate spatial breaks (20px)"
      },
      "xl": {
        "$value": "1.5rem",
        "$description": "Section separation, icon containers (24px)"
      },
      "xxl": {
        "$value": "2rem",
        "$description": "Major structural gaps and popover exit offsets (32px)"
      },
      "xxxl": {
        "$value": "3rem",
        "$description": "Hero typography sizing and macro spacing (48px)"
      }
    },
    "borderRadius": {
      "border-radius": {
        "$value": "{dimension.spacing.s}",
        "$description": "Default component border radius"
      },
      "checkout-card-radius": {
        "$value": "8px",
        "$description": "Border radius for checkout tracking cards and order summaries"
      },
      "timeline-container-radius": {
        "$value": "1.25rem",
        "$description": "Border radius for standalone timeline containers"
      }
    },
    "layout": {
      "max-width-email": {
        "$value": "800px",
        "$description": "Maximum inline-size of email confirmation canvas"
      },
      "header-height-email": {
        "$value": "60px",
        "$description": "Google Store email header height"
      },
      "ec-appbar-h": {
        "$value": "64px",
        "$description": "Gmail web client appbar height"
      },
      "ec-sidebar-w": {
        "$value": "15ch",
        "$description": "Gmail web client sidebar width measure"
      }
    },
    "component": {
      "checkmark-size-desktop": {
        "$value": "1.5rem",
        "$description": "Desktop milestone checkmark circle diameter (24px)"
      },
      "checkmark-size-mobile": {
        "$value": "1.25rem",
        "$description": "Mobile container query milestone checkmark diameter (20px)"
      },
      "checkmark-glyph-inline": {
        "$value": "0.7rem",
        "$description": "Desktop checkmark tick glyph width"
      },
      "checkmark-glyph-block": {
        "$value": "0.35rem",
        "$description": "Desktop checkmark tick glyph height"
      },
      "truck-icon-size": {
        "$value": "24px",
        "$description": "Delivery truck SVG micro-interaction icon size"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "font-stack": {
        "$value": [
          "Recursive",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Primary variable font stack"
      },
      "google-sans": {
        "$value": [
          "Google Sans",
          "Roboto",
          "Arial",
          "sans-serif"
        ],
        "$description": "Google Store brand and transactional font stack"
      }
    },
    "variableAxes": {
      "$type": "number",
      "recursive-wght": {
        "$value": 400,
        "$description": "Recursive variable weight axis (wght: 100-1000)"
      },
      "recursive-CASL": {
        "$value": 0,
        "$description": "Recursive casual axis (CASL: 0.0-1.0)"
      },
      "recursive-MONO": {
        "$value": 0,
        "$description": "Recursive monospace axis (MONO: 0.0-1.0)"
      },
      "recursive-CRSV": {
        "$value": 0.5,
        "$description": "Recursive cursive axis (CRSV: 0.0-1.0)"
      },
      "recursive-slnt": {
        "$value": 0,
        "$description": "Recursive slant axis (slnt: -15 to 0)"
      }
    },
    "fontSize": {
      "$type": "dimension",
      "f-base": {
        "$value": "14px",
        "$description": "Base font size reference value"
      },
      "f-checkout-base": {
        "$value": "16px",
        "$description": "Checkout email document base font size"
      },
      "f-step-label": {
        "$value": "0.85rem",
        "$description": "Desktop milestone step label font size"
      },
      "f-step-label-mobile": {
        "$value": "0.75rem",
        "$description": "Mobile container milestone step label font size"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "link": {
        "$value": "444ms",
        "$description": "Standard link and popover interaction timing"
      },
      "truck-speed": {
        "$value": "760ms",
        "$description": "Delivery truck stage transit animation duration"
      },
      "check-transition": {
        "$value": "200ms",
        "$description": "Milestone checkmark fill and scale transition duration"
      },
      "line-progress": {
        "$value": "250ms",
        "$description": "Progress line fill keyframe animation duration"
      }
    },
    "cubicBezier": {
      "$type": "cubicBezier",
      "link": {
        "$value": [0.2, 0.8, 0.2, 1],
        "$description": "Primary interactive easing curve"
      },
      "ease-3": {
        "$value": [0.25, 0, 0.3, 1],
        "$description": "Secondary smooth acceleration curve"
      },
      "truck-spring": {
        "$value": [0.68, -0.24, 0.265, 1.24],
        "$description": "Spring easing for delivery truck horizontal translation"
      },
      "truck-entrance": {
        "$value": [0.68, -0.55, 0.265, 1.55],
        "$description": "Overshoot spring curve for delivery truck starting entrance"
      },
      "check-ease": {
        "$value": [0.4, 0.0, 0.2, 1],
        "$description": "Material standard curve for checkmark glyph scaling"
      },
      "premium-ease": {
        "$value": [0.23, 1, 0.32, 1],
        "$description": "Premium deceleration curve for checkout slide transitions"
      }
    }
  }
}
