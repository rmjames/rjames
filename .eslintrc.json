{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-inner-declarations": "warn",
    "no-empty": "warn",
    "no-useless-escape": "warn"
  },
  "globals": {
    "dataLayer": true,
    "gtag": true
  }
}
